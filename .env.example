# MaubereSec AI configuration (copy to .env and fill in).
# API keys are read from the environment only — never commit real values.

# Provider API key (env var name follows <PROVIDER>_API_KEY convention).
# This is the only required value.
OPENAI_API_KEY=

# Optional. With only OPENAI_API_KEY set, provider defaults to "openai" and
# model defaults to "gpt-4o-mini". Uncomment to override either.
# MSAI_PROVIDER=openai
# MSAI_MODEL=gpt-4o-mini

# Optional: request timeout in seconds (default 30)
# MSAI_TIMEOUT=30
